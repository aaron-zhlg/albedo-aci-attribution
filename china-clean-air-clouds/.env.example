# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# Host folder that receives the data (needs ~0.5 TB free). Windows example: D:/climate-data/china
DATA_DIR=./data

# NASA Earthdata login (https://urs.earthdata.nasa.gov) for MODIS, CERES, MERRA-2 and OMI
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Copernicus Climate Data Store API token (https://cds.climate.copernicus.eu, profile page)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Optional overrides of scripts/config.sh
# START_YEAR=1980
# END_YEAR=2024
# THREADS=8
